# ============================================================================
# matmoora-web — environment variables
# ============================================================================
# For local dev, copy to `.env.local` and fill in. Only `.env.example` is
# committed. In production (Vercel), these go in the project's Environment
# Variables panel.

# --- Fixture mode (no backend needed) -----------------------------------------
# Set to 1 to render the site from the in-repo fixtures (no WPGraphQL calls).
# Perfect for the first Vercel preview deploy before the Railway CMS is live.
MATMOORA_FIXTURES=1
NEXT_PUBLIC_MATMOORA_FIXTURES=1

# --- WordPress / CMS ---------------------------------------------------------
# Public WPGraphQL endpoint. The only API surface from WP (TECH_SPEC §3, §17.3).
# When running on Railway, this is the WordPress service's public URL + /graphql.
WORDPRESS_GRAPHQL_ENDPOINT=https://cms.matmoora.org/graphql
# Base URL of the WordPress install — used by API proxies (forms, comments).
WP_BASE_URL=https://cms.matmoora.org
# Forms submit path on WP. Default targets Fluent Forms; override for Gravity.
WP_FORM_SUBMIT_PATH=/wp-json/fluentform/v1/submit

# --- Revalidation (WP webhook -> on-demand ISR, TECH_SPEC §7.4) ---------------
# Shared secret; must match MATMOORA_REVALIDATE_SECRET on the WP server.
REVALIDATE_SECRET=

# --- Preview / draft mode (TECH_SPEC §8) --------------------------------------
PREVIEW_SECRET=
WP_PREVIEW_TOKEN=

# --- Search / Meilisearch (TECH_SPEC §12) -------------------------------------
MEILI_HOST=https://search.matmoora.org
# Search-only key (cannot modify data). Safe to use from the server-side proxy.
MEILI_SEARCH_KEY=

# --- Forms / spam (TECH_SPEC §13.4) -------------------------------------------
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Observability (TECH_SPEC §20) -------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Environment --------------------------------------------------------------
# 'production' | 'staging' | 'development' — drives robots.ts (TECH_SPEC §10.3)
# and the production-only CSP / HSTS headers in next.config.ts.
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
