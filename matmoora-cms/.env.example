# ============================================================================
# matmoora-cms — environment variables (works on Railway and on a VPS)
# ============================================================================

# --- Database -----------------------------------------------------------------
# On Railway, add the "MariaDB" plugin — it provides MYSQL_URL automatically.
# On a VPS the compose file supplies the discrete values below instead.
MYSQL_URL=
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=
WORDPRESS_DB_NAME=wordpress

# --- Meilisearch (separate Railway service, same host on a VPS) ---------------
MEILI_HOST=http://meili:7700
MEILI_MASTER_KEY=

# --- Revalidation webhook (TECH_SPEC §7.4) ------------------------------------
# Where WP POSTs when content changes.
MATMOORA_REVALIDATE_URL=https://matmoora.org/api/revalidate
# Shared secret; must match REVALIDATE_SECRET on the Next.js side.
MATMOORA_REVALIDATE_SECRET=

# --- Public URL --------------------------------------------------------------
# Any direct hit to WordPress's frontend is redirected here (stub theme).
MATMOORA_PUBLIC_URL=https://matmoora.org

# --- WordPress salts ---------------------------------------------------------
# Generate from https://api.wordpress.org/secret-key/1.1/salt/ and paste below.
# On Railway, set these as separate env vars; on a VPS they live in secrets/.
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=
