# Environment for the WordPress container. Real values live on the VPS, never
# committed. Docker Compose reads this file; secrets/* hold DB + Meili keys.

# Frontend integration -------------------------------------------------------
# Next.js revalidation endpoint + shared secret (must match the Vercel env).
MATMOORA_REVALIDATE_URL=https://matmoora.org/api/revalidate
MATMOORA_REVALIDATE_SECRET=
# Public frontend origin — the stub theme redirects front-end hits here.
MATMOORA_FRONTEND_URL=https://matmoora.org

# Meilisearch ----------------------------------------------------------------
# Reachable from the WordPress container (compose service name on the VPS).
MATMOORA_MEILI_HOST=http://meilisearch:7700
# Admin key — indexes and deletes documents. NOT the search-only key.
MATMOORA_MEILI_ADMIN_KEY=
